// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(100)
  senha        String   @db.VarChar(255)
  tipo         TipoUsuario @default(PORTEIRO)
  ativo        Boolean  @default(true)
  ultimoAcesso DateTime?
  dataCadastro DateTime @default(now())
  
  registros    RegistroVisita[]
  blacklistAdicionada Blacklist[]
  
  @@map("usuarios")
}

enum TipoUsuario {
  ADMIN
  PORTEIRO
}

model Visitante {
  id             String   @id @default(uuid())
  nome           String   @db.VarChar(100)
  cpf            String   @unique @db.VarChar(11)
  dataNascimento DateTime?
  foto           String   @db.VarChar(500)
  thumbnailUrl   String?  @db.VarChar(500)
  tipo           TipoVisita @default(VISITA)
  dataCadastro   DateTime @default(now())
  dataAtualizacao DateTime @updatedAt
  status         StatusVisitante @default(CADASTRADO)
  totalVisitas   Int      @default(0)
  ultimaVisita   DateTime?
  
  registros      RegistroVisita[]
  
  @@index([cpf])
  @@index([status])
  @@map("visitantes")
}

enum TipoVisita {
  VISITA
}

enum StatusVisitante {
  CADASTRADO
  DENTRO
  FORA
}

model RegistroVisita {
  id            String   @id @default(uuid())
  visitanteId   String
  foto          String   @db.VarChar(500)
  thumbnailUrl  String?  @db.VarChar(500)
  dataEntrada   DateTime @default(now())
  dataSaida     DateTime?
  status        StatusRegistro @default(DENTRO)
  metodoEntrada MetodoEntrada @default(DOCUMENTO)
  porteiroId    String?
  dataCadastro  DateTime @default(now())
  
  visitante     Visitante @relation(fields: [visitanteId], references: [id], onDelete: Cascade)
  porteiro      Usuario?  @relation(fields: [porteiroId], references: [id])
  
  @@index([status])
  @@index([dataEntrada])
  @@index([visitanteId])
  @@map("registros_visita")
}

enum StatusRegistro {
  DENTRO
  FORA
}

enum MetodoEntrada {
  DOCUMENTO
}

model Blacklist {
  id            String   @id @default(uuid())
  cpf           String   @unique @db.VarChar(11)
  nome          String   @db.VarChar(100)
  motivo        String   @db.VarChar(500)
  dataAdicao    DateTime @default(now())
  adicionadoPor String
  ativo         Boolean  @default(true)
  dataRemocao   DateTime?
  
  adicionadoPorUsuario Usuario @relation(fields: [adicionadoPor], references: [id])
  
  @@map("blacklist")
}
